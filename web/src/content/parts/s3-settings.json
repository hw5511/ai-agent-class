          "vendor": "claude",
          "cwd": "C:\\agent1",
          "turns": [],
          "input": {
            "placeholder": "메시지를 입력하세요..."
          }
        }
      },
      "notes": [
        {
          "n": 1,
          "head": "숨김 폴더 .claude 안",
          "body": "settings.json 은 CLAUDE.md 처럼 숨김 폴더인 .claude 안에 있습니다."
        },
        {
          "n": 2,
          "head": "파일 이름 settings.json",
          "body": "이 파일 하나에 도구 실행 규칙, 모델, 환경변수까지 함께 저장됩니다."
        }
      ]
    },
    {
      "id": "s3-settings-02",
      "template": "cards",
      "title": "주요 설정 항목",
      "cards": [
        {
          "label": "permissions",
          "logo": "icon:Shield",
          "tags": [
            "allow / deny / ask",
            "\"deny\": [\"Bash(rm:*)\"]"
          ],
          "highlight": true
        },
        {
          "label": "model",
          "logo": "icon:Cpu",
          "tags": [
            "세션 기본 모델",
            "\"model\": \"claude-sonnet-5\""
          ]
        },
        {
          "label": "env",
          "logo": "icon:Settings",
          "tags": [
            "환경변수 전달",
            "\"env\": { \"MY_VAR\": \"value\" }"
          ]
        },
        {
          "label": "hooks",
          "logo": "icon:Zap",
          "tags": [
            "도구 전후 실행",
            "\"hooks\": { \"PreToolUse\": [...] }"
          ]
        }
      ],
      "notes": [
        {
          "n": 1,
          "head": "permissions",
          "body": "permissions 는 allow, deny, ask 세 목록으로 어떤 동작을 허용할지 결정합니다."
        },
        {
          "n": 2,
          "head": "model",
          "body": "model 항목에는 세션에서 기본으로 쓸 모델을 지정합니다."
        }
      ]
    },
    {
      "id": "s3-settings-03",
      "template": "screen",
      "title": "삭제 명령어 금지",
