      "action": {
        "label": "프롬프트 복사",
        "items": [
          {
            "kind": "copy",
            "value": "현재 폴더의 .claude 폴더에 settings.json 파일을 만들어서 모든 삭제 명령어를 금지시켜줘"
          }
        ]
      }
    },
    {
      "id": "s3-settings-04",
      "template": "screen",
      "title": "생성된 deny 규칙",
      "screen": {
        "kind": "vscode",
        "folder": "agent1",
        "files": [
          {
            "name": ".claude",
            "folder": true
          },
          {
            "name": "settings.json",
            "depth": 1,
            "active": true
          }
        ],
        "editor": {
          "file": ".claude/settings.json",
          "lines": [
            "{",
            "  \"permissions\": {",
            "    \"deny\": [",
            "      \"Bash(rm:*)\",",
            "      \"Bash(rmdir:*)\",",
            "      \"Bash(unlink:*)\",",
            "      \"Bash(shred:*)\",",
            "      \"Bash(find:* -delete*)\",",
            "      \"Bash(git rm:*)\",",
            "      \"Bash(git clean:*)\",",
            "      \"PowerShell(Remove-Item:*)\",",
            "      \"PowerShell(ri:*)\",",
            "      \"PowerShell(rm:*)\",",
            "      \"PowerShell(rmdir:*)\",",
            "      \"PowerShell(del:*)\",",
            "      \"PowerShell(erase:*)\",",
            "      \"PowerShell(rd:*)\",",
            "      \"PowerShell(Clear-Content:*)\",",
            "      \"PowerShell(git rm:*)\",",
            "      \"PowerShell(git clean:*)\"",
            "    ]",
            "  }",
            "}"
          ]
        },
        "terminal": {
          "vendor": "claude",
          "cwd": "C:\\agent1",
          "turns": [],
          "input": {
            "placeholder": "메시지를 입력하세요..."
          }
        }
      },
      "notes": [
        {
          "n": 1,
          "head": "Bash·PowerShell 양쪽 다",
          "body": "rm / Remove-Item 계열 명령을 두 셸 모두에서 deny 에 넣었다."
        },
        {
          "n": 2,
          "head": "이름 패턴으로 차단",
          "body": "\"PowerShell(rm:*)\" 처럼 명령 이름 + 별표 패턴으로 막는다."
        },
        {
          "n": "!",
          "head": "한계도 있다",
          "body": "Write/Edit 툴로 파일을 덮어써서 비우는 것까지는 막지 못한다."
        }
      ]
    },
