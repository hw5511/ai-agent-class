        "editor": {
          "file": ".claude/settings.json",
          "lines": [
            "{",
            "  \"permissions\": {",
            "    \"deny\": [",
            "      \"Bash(rm:*)\",",
            "      \"Bash(rmdir:*)\",",
            "      \"Bash(unlink:*)\",",
            "      \"Bash(shred:*)\",",
            "      \"Bash(find:* -delete*)\",",
            "      \"Bash(git rm:*)\",",
            "      \"Bash(git clean:*)\",",
            "      \"PowerShell(Remove-Item:*)\",",
            "      \"PowerShell(ri:*)\",",
            "      \"PowerShell(rm:*)\",",
            "      \"PowerShell(rmdir:*)\",",
            "      \"PowerShell(del:*)\",",
            "      \"PowerShell(erase:*)\",",
            "      \"PowerShell(rd:*)\",",
            "      \"PowerShell(Clear-Content:*)\",",
            "      \"PowerShell(git rm:*)\",",
            "      \"PowerShell(git clean:*)\"",
            "    ]",
            "  }",
            "}"
          ]
        },
        "terminal": {
          "vendor": "claude",
          "cwd": "C:\\agent1",
          "turns": [],
          "input": {
            "placeholder": "메시지를 입력하세요..."
          }
        }
      },
      "notes": [
        {
          "n": 1,
          "head": "Bash · PowerShell 모두",
          "body": "rm / Remove-Item 계열, 두 셸 모두 deny 등록"
        },
        {
          "n": 2,
          "head": "이름 패턴으로 차단",
          "body": "\"PowerShell(rm:*)\" 처럼 이름 + 별표 패턴으로 차단"
        },
        {
          "n": "!",
          "head": "한계도 있음",
          "body": "Write/Edit 로 덮어쓰는 것은 못 막음"
        }
      ]
