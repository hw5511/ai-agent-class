          "terminal": {
            "vendor": "claude",
            "cwd": "C:\\agent1",
            "turns": [
              {
                "role": "user",
                "text": "200초 후에 완료되는 명령어를 포어그라운드로 실행해볼래?"
              },
              {
                "role": "tool",
                "text": "PowerShell($s = Get-Date; Start-Sleep -Seconds 200; \"완료: $([int]((Get-Date) - $s).TotalSeconds)초 경과\")"
              }
            ],
            "input": {
              "placeholder": "메시지를 입력하세요..."
