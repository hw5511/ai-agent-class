      "steps": [
        { "label": "Read", "sub": "현재 코드 확인", "logo": "icon:Read", "badge": 1 },
        { "label": "Edit", "sub": "바뀔 값 수정", "logo": "icon:Edit", "badge": 2 },
        { "label": "Bash", "sub": "다시 실행", "logo": "icon:Bash", "badge": 3 }
