      "rows": [
        { "cells": ["Auto-update channel", "선택", "—"] },
        { "cells": ["Theme", "선택", "—"] },
        { "cells": ["Notifications", "선택", "—"] },
        { "cells": ["Push when actions required", "ON/OFF", "—"] },
        { "cells": ["Push when Claude decides", "ON/OFF", "—"] },
        { "cells": ["Output style", "선택", "—"] },
        { "cells": ["Default view", "선택", "—"] },
        { "cells": ["Language", "선택", "Default (English)"] },
        { "cells": ["Editor mode", "선택", "—"] },
        { "cells": ["Question auto-continue timeout", "선택", "—"] },
        { "cells": ["Claude-proposed goals", "선택", "—"] },
        { "cells": ["Show last response in external editor", "ON/OFF", "—"] },
        { "cells": ["Show PR status footer", "ON/OFF", "—"] },
        { "cells": ["Model", "선택", "Default (recommended)"] },
        { "cells": ["Diff tool", "선택", "—"] },
        { "cells": ["Auto-connect to IDE (external terminal)", "ON/OFF", "—"] },
        { "cells": ["Use auto mode during plan", "ON/OFF", "—"] },
        { "cells": ["Respect .gitignore in file picker", "ON/OFF", "—"] },
        { "cells": ["Skip the /copy picker", "ON/OFF", "—"] },
        { "cells": ["Copy on select", "ON/OFF", "—"] },
        { "cells": ["Auto-scroll", "ON/OFF", "—"] },
        { "cells": ["Agents view", "선택", "—"] },
        { "cells": ["Open agents view by default", "ON/OFF", "—"] },
        { "cells": ["← opens agents", "ON/OFF", "—"] },
        { "cells": ["Session recap", "ON/OFF", "—"] }
      ]
    },
    {
      "id": "s3-config-03",
      "template": "table",
      "title": "Language 한국어",
      "columns": ["설정 항목", "값"],
      "rows": [
        { "cells": ["Language", "한국어 (입력 중)"], "highlight": true }
      ],
      "notes": [
        { "n": 1, "head": "Language 항목에 직접 입력", "body": "언어 이름 그대로(예: 한국어) 또는 ISO 코드로 입력한다." },
        { "n": 2, "head": "패널이 보여주는 원문 안내", "body": "Any language name or ISO code (e.g. 'ja'); use 'default' for English." },
        { "n": "!", "head": "아무것도 안 바꾸면", "body": "Default (English) 로 그대로 남는다." }
      ],
      "action": {
        "label": "Language 항목에 입력",
        "items": [
          { "kind": "copy", "value": "한국어" }
        ]
      }
    },
    {
      "id": "s3-config-04",
      "template": "table",
      "title": "/status · Organization 확인",
      "columns": ["항목", "값"],
