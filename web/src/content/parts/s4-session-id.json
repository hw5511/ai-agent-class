              "role": "assistant",
              "text": "claude --resume [세션 id]"
            },
            {
              "role": "user",
              "text": "claude --dangerously-skip-permissions --resume [세션 id]",
              "mark": "--resume [세션 id]",
              "badge": 2
            }
          ]
