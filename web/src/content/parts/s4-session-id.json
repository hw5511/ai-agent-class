      "template": "screen",
      "title": "bypass 모드로 시작",
      "screen": {
        "kind": "vscode",
        "folder": "agent1",
        "files": [],
        "noSidebar": true,
        "terminal": {
          "vendor": "claude",
          "cwd": "C:\\agent1",
          "turns": [
            {
              "role": "user",
              "text": "간단하게 자기소개 해볼래?",
