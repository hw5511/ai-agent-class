      },
      "notes": [
        {
          "n": 1,
          "head": "채팅 하나 = 세션 하나",
          "body": "ChatGPT 왼쪽 목록의 한 칸"
        },
        {
          "n": 2,
          "head": "채팅 목록 = 세션 목록",
          "body": "Claude Code 도 같은 구조"
